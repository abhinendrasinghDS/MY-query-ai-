APP_ENV=production
APP_NAME=My Query AI API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,https://my-query-ai-web.onrender.com
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATA_DIR=./data
DEMO_DATASET_DIR=../../datasets/demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=90
QUERY_TIMEOUT_SECONDS=8
QUERY_MAX_ROWS=500
UPLOAD_MAX_MB=20

# LLM provider: auto | gemini | grok | ollama | mock
LLM_PROVIDER=auto

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest
GEMINI_TIMEOUT_SECONDS=60

# ── xAI Grok ─────────────────────────────────────────────────────────────────
GROK_API_KEY=
GROK_MODEL=grok-beta
GROK_TIMEOUT_SECONDS=60
